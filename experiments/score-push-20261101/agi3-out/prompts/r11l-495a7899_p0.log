def chainsolve(chain, target, B, W=500, maxdepth=6, k=None):
    BC=set()
    for r in range(2,62):
        for c in range(2,62):
            if shape_ok((r,c),'bead',B): BC.add((r,c))
    V=[]
    for r in range(2,62):
        for c in range(2,62):
            if shape_ok((r,c),'end',B): V.append((r,c))
    k=len(chain)
    S=[sum(p[0] for p in chain), sum(p[1] for p in chain)]
    def bead(s): return (s[0]//k, s[1]//k)
    def dist(b): return abs(b[0]-target[0])+abs(b[1]-target[1])
    start=(tuple(sorted(chain)), tuple(S))
    beam=[(start,0,[])]
    seen={start}
    for depth in range(maxdepth+1):
        cur=[x for x in beam if bead(x[0][1])==(target[0],target[1]) or True]
        for st,path,d in beam:
            if bead(st[1])==(target[0],target[1]):
                return path
        nxt=[]
        for st,path,d in beam:
            pos=list(st[0]); s=list(st[1])
