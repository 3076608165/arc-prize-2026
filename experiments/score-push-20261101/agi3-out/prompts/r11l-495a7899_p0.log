    k=len(chain)
    S=(sum(p[0] for p in chain), sum(p[1] for p in chain))
    def bead(s): return (s[0]//k, s[1]//k)
    def dist(b): return abs(b[0]-target[0])+abs(b[1]-target[1])
    start=(tuple(sorted(chain)), S)
    beam=[(start,[],dist(bead(S)))]
    seen={start}
    if bead(S)==target: return []
    for depth in range(maxdepth):
        nxt=[]
        for st,path,d in beam:
            pos=list(st[0]); s=st[1]
            for i in range(k):
                old=pos[i]
                base=(s[0]-old[0], s[1]-old[1])
                for t in V:
                    ns=(base[0]+t[0], base[1]+t[1])
                    b=(ns[0]//k, ns[1]//k)
