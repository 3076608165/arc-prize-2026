                    seen.add(key)
                    if b==target: return path+[(old,t)]
                    nxt.append(((np2,ns), path+[(old,t)], dd))
        if not nxt: return None
        nxt.sort(key=lambda x:x[2])
        beam=nxt[:W]
    return None
