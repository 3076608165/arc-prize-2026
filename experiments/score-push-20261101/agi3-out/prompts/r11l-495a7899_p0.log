def plan():
    a = current_frame.ascii.split('\n')
    water=set(); back=set(); clear=set()
    for r in range(64):
        row=a[r]
        for c in range(64):
            ch=row[c]
            if ch=='S': water.add((r,c))
            elif ch=='g': back.add((r,c))
            elif ch=='B': clear.add((r,c))
    def ok(p): return (0<=p[0]<64) and (0<=p[1]<64) and p not in water and p not in back
    def seg_clear(p,q):
        dr=q[0]-p[0]; dc=q[1]-p[1]; n=max(abs(dr),abs(dc))
        if n==0: return True
        for i in range(n+1):
            r=p[0]+round(dr*i/n); c=p[1]+round(dc*i/n)
            if (r,c) in water or (r,c) in back: return False
        return True
    def valid(chain):
        if not chain: return True
        bead=(sum(p[0] for p in chain)//len(chain), sum(p[1] for p in chain)//len(chain))
        if not ok(bead): return False
        for p in chain:
            if not ok(p) or not seg_clear(bead,p): return False
        return True
    cands=[p for p in clear]
    cands.sort(key=lambda p: abs(p[0]-51)+abs(p[1]-40))
    bad=[(6,17),(9,49),(21,8)]
    sums=[(sr,sc) for sr in (153,154,155) for sc in (120,121,122)]
    sol=[]
    def dfs(G, R, path):
        if sol: return
        if not R:
            for s in sums:
                last=(s[0]-sum(p[0] for p in G), s[1]-sum(p[1] for p in G))
                if ok(last) and valid(G+[last]):
                    sol.append(path+[(None,last)])
                    return
            return
        for i,b in enumerate(R):
            Rr=[x for j,x in enumerate(R) if j!=i]
            for t in cands:
                if not valid(G+[t]+Rr): continue
                dfs(G+[t], Rr, path+[(b,t)])
                if sol: return
    dfs([], bad, [])
    return sol
print('searching...')
