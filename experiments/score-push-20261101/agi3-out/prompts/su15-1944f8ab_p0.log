def msquares(f):
    out=[]
    for n in f.segmentation['nodes']:
        if n['color']=='M' and n['pixels']==4:
            b=n['boundary']; rs=[p[0] for p in b]; cs=[p[1] for p in b]
            if min(rs)>=10: out.append((min(rs),min(cs)))
    return out
def move_test(pos, rr, cc):
    r = action([{'action':'MOUSE','row':rr,'col':cc}])
    sq = msquares(current_frame)
    # nearest to pos
    best = min(sq, key=lambda p:(abs(p[0]-pos[0])+abs(p[1]-pos[1])))
    d = (best[0]-pos[0], best[1]-pos[1])
    print(f'  click({rr},{cc}) sq {pos} -> {best} delta {d} chg={r["gameplay_changed"]}')
    return best
