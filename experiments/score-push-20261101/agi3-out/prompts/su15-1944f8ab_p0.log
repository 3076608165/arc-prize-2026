def squares(f):
    out=[]
    for n in f.segmentation['nodes']:
        b=n['boundary']; r0=min(p[0] for p in b); c0=min(p[1] for p in b)
        if r0<10: continue
        if n['color'] in ('M','p','Y') and n['pixels'] in (4,9,16):
            s=2 if n['pixels']==4 else (3 if n['pixels']==9 else 4)
            out.append({'c':n['color'],'s':s,'t':(r0,c0)})
    return out
def cd(cell, sq):
    r,c=cell; r0,c0=sq['t']; s=sq['s']
    return max(max(r0-r, r-(r0+s-1), 0), max(c0-c, c-(c0+s-1), 0))
def chk(click, want):
    # want: list of top-lefts expected in range; returns (ok, inrange)
    sq=squares(current_frame)
    ir=[q for q in sq if cd(click,q)<=7]
    ok = sorted(q['t'] for q in ir)==sorted(want)
    return ok, [(q['c'],q['t']) for q in ir]
def moveto(t, tgt):
    # move 2x2 at top-left t to tgt, greedy, with safety checks
    cur=t
    while cur!=tgt:
        dr=max(-2,min(7,tgt[0]-cur[0])); dc=max(-2,min(7,tgt[1]-cur[1]))
        nt=(cur[0]+dr,cur[1]+dc); click=(nt[0]+1,nt[1]+1)
        ok,ir=chk(click,[cur])
        if not ok:
            print('  UNSAFE at',click,'inrange',ir); return cur,False
        r=action([{'action':'MOUSE','row':click[0],'col':click[1]}])
        sq=squares(current_frame)
        m=[q for q in sq if q['t']==nt and q['c']=='M']
        if not m:
            print('  FAIL click',click,'->',[(q['c'],q['t']) for q in sq],'moved',r['gameplay_changed']); return cur,False
        cur=nt
        if r['level_completed'] or r.get('done'): print('  DONE!'); return cur,True
    return cur,True
print('current', [(q['c'],q['t']) for q in squares(current_frame)])
</parameter>
</function>
