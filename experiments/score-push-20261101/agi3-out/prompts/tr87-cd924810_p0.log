def rot90(g):
    n=len(g); m=len(g[0])
    return [''.join(g[n-1-c][r] for c in range(n)) for r in range(m)]
def mirr(g):
    return [row[::-1] for row in g]
def dihset(g):
    out=set(); cur=list(g)
    for _ in range(4):
        out.add(tuple(cur)); mm=tuple(mirr(cur))
        out.add(mm)
        cur=rot90(cur)
    return out
