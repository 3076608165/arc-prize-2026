def can_reach(s0, cap=20000):
    seen={s0}; q=deque([s0]); best=None
    while q:
        s=q.popleft()
        n,t,R,b,N=s
        if R[1]==18 and N[1]==18 and b[1]==18 and R[0]<N[0]<b[0]:
