import re
def blocks(fr):
    a = fr.ascii.split('\n')
    out = {}
    for col in ('R','b','N'):
        cells = [(r,c) for r in range(64) for c in range(64) if a[r][c]==col]
        if cells:
            r0 = min(x[0] for x in cells); c0 = min(x[1] for x in cells)
            out[col] = (r0, c0)
    # ring top row
    ring = next((r for r in range(64) if 'MMMMMM' in a[r][8:20]), None)
    tip = None
    if ring is not None:
        row = a[ring+2]
        cs = [c for c in range(17,64) if row[c] in 'wg']
        tip = max(cs) if cs else 16
    return out, (ring+2 if ring is not None else None), tip

rows=[]
prev=None
for i,h in enumerate(history):
    b,rc,tip = blocks(h.frame)
    rows.append((i,h.action,b,rc,tip))
for r in rows:
    print(r)
