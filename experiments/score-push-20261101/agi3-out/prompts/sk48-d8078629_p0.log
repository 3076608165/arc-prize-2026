def model_state(fr):
    a=fr.ascii.split('\n')
    pos={}
    for col in ('R','b','N'):
        cells=[(r,c) for r in range(50) for c in range(64) if a[r][c]==col]
        r0=min(x[0] for x in cells); c0=min(x[1] for x in cells)
        pos[col]=(r0+1, c0)
    ring=next((r for r in range(50) if 'MMMMMM' in a[r][8:20]),None)
    n=ring+2
    row=a[n]
    cs=[c for c in range(17,64) if row[c] in 'wg']
    t=max(cs) if cs else 16
    return (n,t,tuple(pos['R']),tuple(pos['b']),tuple(pos['N']))

