def tray_icons(fr):
    a=fr.ascii.split('\n')
    # find tray ring row: row containing 'MWWWWM' with row>50
    rr=next((r for r in range(50,64) if 'MWWWWM' in a[r]),None)
    if rr is None: return None
    out={'row':rr}
    # blocks in tray: scan row rr+2 for color runs after col 26
    row=a[rr+2]
    # check center of each 4-wide block: find runs
    import re
    runs=[(m.group(0),m.start()) for m in re.finditer(r'(R{4}|N{4}|b{4})',row)]
    for col,c in runs:
        # hollow if row rr+1 (top of block) is 'W' inside
        top=a[rr+1][c:c+4]
        out[col]=(c,'hollow' if 'W' in top or 'W' in row[c:c+4] else 'solid')
    return out
for i in [0,1,10,20,30,40,50,57,58,60,62,64,70,80,90,100,110,119,120,127,130,140,150,151]:
    if i<len(history):
        print(i, history[i].action, tray_icons(history[i].frame))
