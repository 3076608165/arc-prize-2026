def tray_icons(fr):
    a=fr.ascii.split('\n')
    # find tray ring row: row containing 'MWWWWM' with row>50
    rr=next((r for r in range(50,64) if 'MWWWWM' in a[r]),None)
    if rr is None: return None
    out={'row':rr}
    # blocks in tray: scan row rr+2 for color runs after col 26
    row=a[rr+2]
    # check center of each 4-wide block: find runs
    import re
