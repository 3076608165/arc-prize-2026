def plusinfo(fr):
    lines=fr.ascii.split('\n')
    pts=set((r,c) for r,l in enumerate(lines) for c,ch in enumerate(l) if ch=='b')
    from collections import Counter
    rc=Counter(r for r,c in pts); cc=Counter(c for r,c in pts)
    rows=[r for r,k in rc.items() if k>=5]; cols=[c for c,k in cc.items() if k>=5]
    if not rows or not cols: return {'pts':len(pts),'rows':rows,'cols':cols}
    row=rows[0]; col=cols[0]
    sub=[(r,c) for r,c in pts if r==row or c==col]
    rs=[p[0] for p in sub]; cs=[p[1] for p in sub]
    return dict(px=len(pts),center=(row,col),up=row-min(rs),down=max(rs)-row,left=col-min(cs),right=max(cs)-col)
print(plusinfo(current_frame))
