def plusinfo(fr):
    seg=fr.segmentation['nodes']
    cand=[n for n in seg if n['color']=='b' and n['pixels']>20]
    if not cand: return None
    n=max(cand,key=lambda x:x['pixels'])
    b=n['boundary']
    # reconstruct pixel set from ascii instead
    lines=fr.ascii.split('\n')
    pts=[(r,c) for r,l in enumerate(lines) for c,ch in enumerate(l) if ch=='b']
    # keep only those within the plus bbox
    rs=[p[0] for p in pts]; cs=[p[1] for p in pts]
    # cluster: the plus is the largest; use rows/cols counts
    from collections import Counter
    rc=Counter(r for r,c in pts); cc=Counter(c for r,c in pts)
    row=max(rc,key=lambda k:rc[k]); col=max(cc,key=lambda k:cc[k])
    sub=[(r,c) for r,c in pts if r==row or c==col]
    rs=[p[0] for p in sub]; cs=[p[1] for p in sub]
    return dict(px=n['pixels'],center=(row,col),up=row-min(rs),down=max(rs)-row,left=col-min(cs),right=max(cs)-col)
r=action(['SPACE']); print('W',wpos(),plusinfo(current_frame))
</parameter>
</function>
</tool_call>

