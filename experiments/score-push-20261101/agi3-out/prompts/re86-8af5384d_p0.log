def pstruct(fr):
    lines=fr.ascii.split('\n')
    pts=set((r,c) for r,l in enumerate(lines) for c,ch in enumerate(l) if ch=='b')
    from collections import Counter
    rc=Counter(r for r,c in pts); cc=Counter(c for r,c in pts)
    hr=max(rc,key=lambda k:rc[k]); vc=max(cc,key=lambda k:cc[k])
    hcols=sorted(c for r,c in pts if r==hr); vrows=sorted(r for r,c in pts if c==vc)
    W=[(r,c) for r,l in enumerate(lines) for c,ch in enumerate(l) if ch=='W']
    return dict(hrow=(hr,hcols[0],hcols[-1],len(hcols)),vcol=(vc,vrows[0],vrows[-1],len(vrows)),W=W)
print(pstruct(current_frame))
