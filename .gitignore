# datasets & vendored repos (re-clone with scripts/setup_data.sh)
data/
# local envs
.venv/
venv/
__pycache__/
*.pyc
# secrets - NEVER commit
.kaggle/
kaggle.json
*.token
# local eval outputs
agi2/out/
agi3/out/
# leaderboard dumps (re-downloadable; the parsed read is what gets committed)
experiments/**/*.zip
experiments/arm-*-targets.json
# the fire lock (per-machine, holds no state)
scripts/.fire-next-arm.lock
experiments/*/agi2-out/unsloth_compiled_cache/
experiments/*/agi3-out*/

# gh token lacks workflow scope: keep CI out of the public mirror
.github/
